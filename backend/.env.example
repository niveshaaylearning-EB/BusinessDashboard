# ─── DATABASE ────────────────────────────────────────────────────────────────
# Create this DB + user in psql first:
#   CREATE USER nia_user WITH PASSWORD 'your_strong_password';
#   CREATE DATABASE nia_analyser OWNER nia_user;
DATABASE_URL=postgresql+psycopg://nia_user:CHANGE_THIS_PASSWORD@localhost:5432/nia_analyser
# Running via docker-compose and prefer sqlite instead? Use the mounted volume path:
#   DATABASE_URL=sqlite:////data/nia_analyser.db

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_64_RANDOM_HEX_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── CORS ────────────────────────────────────────────────────────────────────
# JSON array of allowed frontend origins (note the brackets/quotes — required).
# localhost/127.0.0.1 (any port) and private LAN IPs are already allowed automatically
# (see main.py's allow_origin_regex) — this list is for everything else.
#
# Deploying via this repo's docker-compose.yml? You can leave this as-is — nginx
# reverse-proxies the frontend and backend under one public URL, so browser
# requests are same-origin and never hit CORS at all.
#
# Only add your frontend's public URL here if you exposed the backend on its
# OWN separate domain instead (bypassing the nginx proxy):
#   ALLOWED_ORIGINS=["https://your-frontend-domain.example.com"]
ALLOWED_ORIGINS=["http://localhost:5173"]

# ─── ENVIRONMENT ─────────────────────────────────────────────────────────────
# "development" shows /docs (Swagger UI), "production" hides it
ENVIRONMENT=development

# ─── INITIAL ADMIN (used only by setup_db.py — remove ADMIN_PASSWORD after first run) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_MIN_12_CHARS
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@niveshaay.com

# ─── EMAIL (Brevo) ────────────────────────────────────────────────────────────
# Get key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=CHANGE_THIS_BREVO_API_KEY
FROM_EMAIL=communication@niveshaay.com
FROM_NAME=NIA Antigravity
